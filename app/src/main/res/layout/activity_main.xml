<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070B14"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Заголовок -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Умный калькулятор AI"
            android:textColor="#FFFFFF"
            android:textSize="27sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Расчёты • объяснения • AI"
            android:textColor="#8D99AE"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="22dp" />


        <!-- AI -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#111A2B"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🤖  AI-помощник"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Опиши задачу обычными словами или используй фото"
                android:textColor="#8D99AE"
                android:textSize="14sp"
                android:paddingTop="4dp"
                android:paddingBottom="12dp" />

            <EditText
                android:id="@+id/input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="58dp"
                android:background="#18243A"
                android:hint="Например: 15% от 8400"
                android:textColor="#FFFFFF"
                android:textColorHint="#65738A"
                android:textSize="16sp"
                android:padding="16dp"
                android:inputType="textMultiLine"
                android:maxLines="4" />

            <Button
                android:id="@+id/calculateButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Рассчитать с AI"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:background="@drawable/button_operator"
                android:layout_marginTop="12dp" />

            <!-- Кнопка фото -->

            <Button
                android:id="@+id/photoButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="📷  Рассчитать по фото"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:background="@drawable/button_number"
                android:layout_marginTop="10dp" />

            <!-- Превью фотографии -->

            <ImageView
                android:id="@+id/photoPreview"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="12dp"
                android:background="#18243A"
                android:scaleType="centerInside"
                android:contentDescription="Предпросмотр фотографии"
                android:visibility="gone" />

            <!-- Статус фотографии -->

            <TextView
                android:id="@+id/photoStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#8D99AE"
                android:textSize="14sp"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"
                android:visibility="gone" />

            <!-- Результат -->

            <TextView
                android:id="@+id/result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="90dp"
                android:background="#18243A"
                android:text="Ответ AI появится здесь"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp" />

        </LinearLayout>


        <!-- КАЛЬКУЛЯТОР -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Калькулятор"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingTop="24dp"
            android:paddingBottom="10dp" />

        <TextView
            android:id="@+id/calculatorDisplay"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="#111A2B"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:gravity="center_vertical|end"
            android:padding="16dp" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp">

            <!-- Ряд 1 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/buttonClearCalc"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="C"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textAllCaps="false"
                    android:background="@drawable/button_operator"
                    android:layout_margin="3dp" />

                <Button
                    android:id="@+id/buttonBackspace"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="⌫"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textAllCaps="false"
                    android:background="@drawable/button_number"
                    android:layout_margin="3dp" />

                <Button
                    android:id="@+id/buttonPercent"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="%"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textAllCaps="false"
                    android:background="@drawable/button_number"
                    android:layout_margin="3dp" />

                <Button
                    android:id="@+id/buttonDivide"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="÷"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textAllCaps="false"
                    android:background="@drawable/button_operator"
                    android:layout_margin="3dp" />

            </LinearLayout>


            <!-- Ряд 2 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/button7"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="7"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:background="@drawable/button_number"
                    android:layout_margin="3dp" />

                <Button
                    android:id="@+id/button8"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="8"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:background="@drawable/button_number"
                    android:layout_margin="3dp" />

                <Button
                    android:id="@+id/button9"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="9"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:background="@drawable/button_number"
                    android:layout_margin="3dp" />

                <Button
                    android:id="@+id/buttonMultiply"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="×"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textAllCaps="false"
                    android:background="@drawable/button_operator"
                    android:layout_margin="3dp" />

            </LinearLayout>


            <!-- Ряд 3 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/button4"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="4"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:background="@drawable/button_number"
                    android:layout_margin="3dp" />

                <Button
                    android:id="@+id/button5"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="5"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:background="@drawable/button_number"
                    android:layout_margin="3dp" />

                <Button
                    android:id="@+id/button6"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="6"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:background="@drawable/button_number"
                    android:layout_margin="3dp" />

                <Button
                    android:id="@+id/buttonMinus"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="−"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textAllCaps="false"
                    android:background="@drawable/button_operator"
                    android:layout_margin="3dp" />

            </LinearLayout>


            <!-- Ряд 4 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/button1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="1"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:background="@drawable/button_number"
                    android:layout_margin="3dp" />

                <Button
                    android:id="@+id/button2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="2"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:background="@drawable/button_number"
                    android:layout_margin="3dp" />

                <Button
                    android:id="@+id/button3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="3"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:background="@drawable/button_number"
                    android:layout_margin="3dp" />

                <Button
                    android:id="@+id/buttonPlus"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="+"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textAllCaps="false"
                    android:background="@drawable/button_operator"
                    android:layout_margin="3dp" />

            </LinearLayout>


            <!-- Ряд 5 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/buttonOpenBracket"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="("
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textAllCaps="false"
                    android:background="@drawable/button_number"
                    android:layout_margin="3dp" />

                <Button
                    android:id="@+id/button0"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:background="@drawable/button_number"
                    android:layout_margin="3dp" />

                <Button
                    android:id="@+id/buttonDot"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="."
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:background="@drawable/button_number"
                    android:layout_margin="3dp" />

                <Button
                    android:id="@+id/buttonCloseBracket"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text=")"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textAllCaps="false"
                    android:background="@drawable/button_number"
                    android:layout_margin="3dp" />

            </LinearLayout>


            <!-- Ряд равно -->

            <Button
                android:id="@+id/buttonEquals"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="="
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:background="@drawable/button_operator"
                android:layout_margin="3dp" />

        </LinearLayout>


        <!-- ИСТОРИЯ -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="История"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingTop="24dp"
            android:paddingBottom="10dp" />

        <TextView
            android:id="@+id/history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="100dp"
            android:background="#111A2B"
            android:text="История расчётов пока пуста"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="16dp" />

        <Button
            android:id="@+id/clearButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Очистить историю"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:background="@drawable/button_number"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>

</ScrollView>
