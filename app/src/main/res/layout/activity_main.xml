<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070B14"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Заголовок -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Умный калькулятор AI"
            android:textColor="#FFFFFF"
            android:textSize="27sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Расчёты • объяснения • AI"
            android:textColor="#8D99AE"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="22dp" />


        <!-- AI -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#111A2B"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🤖  AI-помощник"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Опиши задачу обычными словами или используй фото"
                android:textColor="#8D99AE"
                android:textSize="14sp"
                android:paddingTop="4dp"
                android:paddingBottom="12dp" />

            <EditText
                android:id="@+id/input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="58dp"
                android:background="#18243A"
                android:hint="Например: 15% от 8400"
                android:textColor="#FFFFFF"
                android:textColorHint="#65738A"
                android:textSize="16sp"
                android:padding="16dp"
                android:inputType="textMultiLine"
                android:maxLines="4" />


            <!-- Кнопка AI -->

            <Button
                android:id="@+id/calculateButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Рассчитать с AI"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:background="@drawable/button_operator"
                android:layout_marginTop="12dp" />


            <!-- Кнопка фото -->

            <Button
                android:id="@+id/photoButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="📷  Рассчитать по фото"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:background="@drawable/button_number"
                android:layout_marginTop="10dp" />


            <!-- Превью фотографии -->

            <ImageView
                android:id="@+id/photoPreview"
                android:layout_width="match_parent"
                android:layout_height="180
