<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070B14"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Умный калькулятор"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AI-помощник для расчётов"
            android:textColor="#8D99AE"
            android:textSize="15sp"
            android:gravity="center"
            android:paddingBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🤖 AI-помощник"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:background="#111A2B"
            android:hint="Например: 15% от 8400"
            android:textColor="#FFFFFF"
            android:textColorHint="#65738A"
            android:textSize="16sp"
            android:padding="16dp"
            android:inputType="text"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/calculateButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Рассчитать с AI"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_operator"
            android:textAllCaps="false"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:background="#111A2B"
            android:text="Ответ появится здесь"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Калькулятор"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/calculatorDisplay"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="#111A2B"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:gravity="center_vertical|end"
            android:padding="16dp"
            android:singleLine="true"
            android:ellipsize="start"
            android:layout_marginBottom="10dp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:useDefaultMargins="false"
            android:alignmentMode="alignBounds">

            <Button
                android:id="@+id/buttonClearCalc"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_columnWeight="1"
                android:text="AC"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_number"
                android:textAllCaps="false"
                android:layout_margin="3dp" />

            <Button
                android:id="@+id/buttonBackspace"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_columnWeight="1"
                android:text="⌫"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_number"
                android:layout_margin="3dp" />

            <Button
                android:id="@+id/buttonPercent"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_columnWeight="1"
                android:text="%"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_number"
                android:layout_margin="3dp" />

            <Button
                android:id="@+id/buttonDivide"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_columnWeight="1"
                android:text="÷"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_operator"
                android:layout_margin="3dp" />

            <Button
                android:id="@+id/buttonOpenBracket"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_columnWeight="1"
                android:text="("
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_number"
                android:layout_margin="3dp" />

            <Button
                android:id="@+id/buttonCloseBracket"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_columnWeight="1"
                android:text=")"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_number"
                android:layout_margin="3dp" />

            <Button
                android:id="@+id/buttonMultiply"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_columnWeight="1"
                android:text="×"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_operator"
                android:layout_margin="3dp" />

            <Button
                android:id="@+id/buttonMinus"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_columnWeight="1"
                android:text="−"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_operator"
                android:layout_margin="3dp" />

            <Button
                android:id="@+id/button7"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_columnWeight="1"
                android:text="7"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_number"
                android:layout_margin="3dp" />

            <Button
                android:id="@+id/button8"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_columnWeight="1"
                android:text="8"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_number"
                android:layout_margin="3dp" />

            <Button
                android:id="@+id/button9"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_columnWeight="1"
                android:text="9"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_number"
                android:layout_margin="3dp" />

            <Button
                android:id="@+id/buttonPlus"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_columnWeight="1"
                android:text="+"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_operator"
                android:layout_margin="3dp" />

            <Button
                android:id="@+id/button4"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_columnWeight="1"
                android:text="4"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_number"
                android:layout_margin="3dp" />

            <Button
                android:id="@+id/button5"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_columnWeight="1"
                android:text="5"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_number"
                android:layout_margin="3dp" />

            <Button
                android:id="@+id/button6"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_columnWeight="1"
                android:text="6"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_number"
                android:layout_margin="3dp" />

            <Button
                android:id="@+id/buttonEquals"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_columnWeight="1"
                android:text="="
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_operator"
                android:layout_margin="3dp" />

            <Button
                android:id="@+id/button1"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_columnWeight="1"
                android:text="1"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_number"
                android:layout_margin="3dp" />

            <Button
                android:id="@+id/button2"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_columnWeight="1"
                android:text="2"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_number"
                android:layout_margin="3dp" />

            <Button
                android:id="@+id/button3"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_columnWeight="1"
                android:text="3"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_number"
                android:layout_margin="3dp" />

            <Button
                android:id="@+id/buttonDot"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_columnWeight="1"
                android:text="."
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_number"
                android:layout_margin="3dp" />

            <Button
                android:id="@+id/button0"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_columnSpan="2"
                android:layout_columnWeight="2"
                android:text="0"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_number"
                android:layout_margin="3dp" />

        </GridLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="История расчётов"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingTop="20dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:background="#111A2B"
            android:text="История расчётов пока пуста"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:padding="16dp" />

        <Button
            android:id="@+id/clearButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Очистить историю"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:background="@drawable/button_number"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>

</ScrollView>
