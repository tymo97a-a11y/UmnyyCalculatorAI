<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070B14"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Умный калькулятор"
            android:textColor="#FFFFFF"
            android:textSize="27sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AI-помощник для расчётов"
            android:textColor="#8491A7"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="18dp" />

        <!-- AI INPUT -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🤖 AI-ПОМОЩНИК"
            android:textColor="#5EA7FF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="7dp" />

        <EditText
            android:id="@+id/input"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="#111A2B"
            android:hint="Например: 15% от 8400"
            android:hintTextColor="#66748A"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:padding="15dp"
            android:inputType="text" />

        <Button
            android:id="@+id/calculateButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Рассчитать с AI"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp" />

        <!-- CALCULATOR -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Калькулятор"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="9dp" />

        <!-- DISPLAY -->

        <TextView
            android:id="@+id/calculatorDisplay"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="#111A2B"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="38sp"
            android:textStyle="bold"
            android:gravity="center_vertical|end"
            android:padding="18dp" />

        <!-- BUTTONS -->

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:rowCount="5"
            android:useDefaultMargins="true"
            android:layout_marginTop="10dp">

            <!-- ROW 1 -->

            <Button
                android:id="@+id/buttonClearCalc"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:text="AC"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/buttonBackspace"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:text="⌫"
                android:textSize="20sp" />

            <Button
                android:id="@+id/buttonPercent"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:text="%"
                android:textSize="20sp" />

            <Button
                android:id="@+id/buttonDivide"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:text="÷"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- ROW 2 -->

            <Button
                android:id="@+id/button7"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:text="7"
                android:textSize="21sp" />

            <Button
                android:id="@+id/button8"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:text="8"
                android:textSize="21sp" />

            <Button
                android:id="@+id/button9"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:text="9"
                android:textSize="21sp" />

            <Button
                android:id="@+id/buttonMultiply"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:text="×"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- ROW 3 -->

            <Button
                android:id="@+id/button4"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:text="4"
                android:textSize="21sp" />

            <Button
                android:id="@+id/button5"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:text="5"
                android:textSize="21sp" />

            <Button
                android:id="@+id/button6"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:text="6"
                android:textSize="21sp" />

            <Button
                android:id="@+id/buttonMinus"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:text="−"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- ROW 4 -->

            <Button
                android:id="@+id/button1"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:text="1"
                android:textSize="21sp" />

            <Button
                android:id="@+id/button2"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:text="2"
                android:textSize="21sp" />

            <Button
                android:id="@+id/button3"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:text="3"
                android:textSize="21sp" />

            <Button
                android:id="@+id/buttonPlus"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:text="+"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- ROW 5 -->

            <Button
                android:id="@+id/button0"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnSpan="2"
                android:layout_columnWeight="2"
                android:text="0"
                android:textSize="21sp" />

            <Button
                android:id="@+id/buttonDot"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:text="."
                android:textSize="21sp" />

            <Button
                android:id="@+id/buttonEquals"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:text="="
                android:textSize="22sp"
                android:textStyle="bold" />

        </GridLayout>

        <!-- AI RESULT -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ответ AI"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="9dp" />

        <TextView
            android:id="@+id/result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#111A2B"
            android:text="Ответ появится здесь"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:padding="17dp"
            android:minHeight="110dp" />

        <Button
            android:id="@+id/clearButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Очистить AI"
            android:textSize="15sp"
            android:layout_marginTop="8dp" />

        <!-- HISTORY -->

        <TextView
            android:id="@+id/historyTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="История расчётов"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="9dp" />

        <TextView
            android:id="@+id/history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#111A2B"
            android:text="История расчётов пока пуста"
            android:textColor="#B9C5D8"
            android:textSize="16sp"
            android:padding="16dp" />

    </LinearLayout>

</ScrollView>
